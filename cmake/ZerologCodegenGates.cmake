include_guard(GLOBAL)

# Native codegen evidence is compiled separately from instrumented tests.
function(zerolog_add_codegen_probes target)
  add_library(${target} OBJECT ${ARGN})
  zerolog_configure_internal(${target} NO_SANITIZERS)
  # Non-PIC object emission preserves direct local-exec TLS codegen for Tier 1 inspection.
  set_target_properties(${target} PROPERTIES INTERPROCEDURAL_OPTIMIZATION FALSE POSITION_INDEPENDENT_CODE FALSE)
  target_compile_options(${target} PRIVATE -O3 -fno-lto)
  target_compile_definitions(${target} PRIVATE NDEBUG)
  # Global coverage settings must not change native instruction evidence.
  if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    target_compile_options(${target} PRIVATE -fno-profile-instr-generate -fno-coverage-mapping)
  elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    target_compile_options(${target} PRIVATE -fno-profile-arcs -fno-test-coverage -fno-profile-generate)
  endif()
  if(DEFINED ZEROLOG_TOOLCHAIN_ROOT AND NOT ZEROLOG_TOOLCHAIN_ROOT STREQUAL "")
    set(_zerolog_tc_root "${ZEROLOG_TOOLCHAIN_ROOT}")
  else()
    set(_zerolog_tc_root "$ENV{HOME}/.local/toolchain")
  endif()
  # GCC objects are audited with a matching-libc Clang IR companion: GCC has no LLVM IR output.
  if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    set(ir_compiler "${CMAKE_CXX_COMPILER}")
  elseif(CMAKE_CXX_COMPILER MATCHES "musl")
    set(ir_compiler "${_zerolog_tc_root}/clang-musl/bin/x86_64-unknown-linux-musl-clang++")
  else()
    set(ir_compiler "${_zerolog_tc_root}/clang-glibc/bin/clang++")
  endif()
  if(NOT EXISTS "${ir_compiler}" AND ZEROLOG_AUTO_DOWNLOAD_TOOLCHAIN AND COMMAND _zerolog_provision_sdk)
    if(CMAKE_CXX_COMPILER MATCHES "musl")
      _zerolog_provision_sdk(clang-musl "${ZEROLOG_TOOLCHAIN_DISTRO}")
    else()
      _zerolog_provision_sdk(clang-glibc "${ZEROLOG_TOOLCHAIN_DISTRO}")
    endif()
  endif()
  if(NOT EXISTS "${ir_compiler}")
    message(FATAL_ERROR "Tier 1 requires the pinned Clang compiler for LLVM IR")
  endif()
  set(ir_outputs)
  foreach(source IN LISTS ARGN)
    get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    get_filename_component(stem "${source}" NAME_WE)
    set(ir "${CMAKE_CURRENT_BINARY_DIR}/${target}-${stem}.ll")
    add_custom_command(OUTPUT "${ir}"
      COMMAND "${ir_compiler}" -std=c++26 -freflection-latest -stdlib=libc++ -fno-exceptions -fno-rtti -DNDEBUG -O3 -fno-lto -S -emit-llvm
        "$<LIST:TRANSFORM,$<TARGET_PROPERTY:${target},INCLUDE_DIRECTORIES>,PREPEND,-I>" "${source}" -o "${ir}" -MD -MF "${ir}.d"
      DEPENDS "${source}" ${target} DEPFILE "${ir}.d" VERBATIM COMMAND_EXPAND_LISTS)
    list(APPEND ir_outputs "${ir}")
  endforeach()
  add_custom_target(${target}_ir ALL DEPENDS ${ir_outputs})
  set_property(TARGET ${target} PROPERTY ZEROLOG_IR_OUTPUTS "${ir_outputs}")
endfunction()
