include_guard(GLOBAL)

# Presets and the CLI name a toolchain before project() can see a compiler id.
if(DEFINED ENV{ZEROLOG_TOOLCHAIN_ROOT} AND NOT "$ENV{ZEROLOG_TOOLCHAIN_ROOT}" STREQUAL "")
  set(_zerolog_toolchain_root_default "$ENV{ZEROLOG_TOOLCHAIN_ROOT}")
elseif(DEFINED ENV{UARCH_TOOLCHAIN_ROOT} AND NOT "$ENV{UARCH_TOOLCHAIN_ROOT}" STREQUAL "")
  set(_zerolog_toolchain_root_default "$ENV{UARCH_TOOLCHAIN_ROOT}")
else()
  set(_zerolog_toolchain_root_default "$ENV{HOME}/.local/toolchain")
endif()
set(ZEROLOG_TOOLCHAIN_ROOT "${_zerolog_toolchain_root_default}" CACHE PATH
  "Root directory for prebuilt C++26 toolchains")
set(ZEROLOG_TOOLCHAIN_NAME "" CACHE STRING
  "Toolchain SDK: clang-glibc, clang-musl, gcc-glibc, or gcc-musl")
set_property(CACHE ZEROLOG_TOOLCHAIN_NAME PROPERTY STRINGS clang-glibc clang-musl gcc-glibc gcc-musl)
set(ZEROLOG_TOOLCHAIN_RELEASE "v0.0.1" CACHE STRING "GitHub release tag for prebuilt toolchains")
option(ZEROLOG_AUTO_DOWNLOAD_TOOLCHAIN "Download a missing prebuilt toolchain" ON)

function(_zerolog_default_distro out_var)
  # v0.0.1 release assets use these suffixes, not the host's VERSION_ID.
  set(distro "ubuntu22")
  if(EXISTS "/etc/os-release")
    file(STRINGS "/etc/os-release" release_lines)
    set(release_id "")
    set(release_like "")
    foreach(line IN LISTS release_lines)
      if(line MATCHES "^ID=(.+)$")
        set(release_id "${CMAKE_MATCH_1}")
        string(REPLACE "\"" "" release_id "${release_id}")
      elseif(line MATCHES "^ID_LIKE=(.+)$")
        set(release_like "${CMAKE_MATCH_1}")
        string(REPLACE "\"" "" release_like "${release_like}")
      endif()
    endforeach()
    set(identity "${release_id} ${release_like}")
    if(identity MATCHES "(^| )alinux( |$)")
      set(distro "alinux3")
    elseif(identity MATCHES "(^| )amzn( |$)")
      set(distro "amazonlinux2")
    elseif(identity MATCHES "(^| )(rhel|rocky|centos|almalinux|fedora)( |$)")
      set(distro "centos7")
    elseif(identity MATCHES "(^| )(ubuntu|debian)( |$)")
      set(distro "ubuntu22")
    endif()
  endif()
  set(${out_var} "${distro}" PARENT_SCOPE)
endfunction()

if(NOT DEFINED ZEROLOG_TOOLCHAIN_DISTRO OR ZEROLOG_TOOLCHAIN_DISTRO STREQUAL "")
  _zerolog_default_distro(_zerolog_detected_distro)
else()
  set(_zerolog_detected_distro "${ZEROLOG_TOOLCHAIN_DISTRO}")
endif()
set(ZEROLOG_TOOLCHAIN_DISTRO "${_zerolog_detected_distro}" CACHE STRING
  "Distro tag used in prebuilt toolchain archive names")

function(_zerolog_toolchain_spec name out_repo out_prefix out_compiler)
  if(name STREQUAL "clang-glibc")
    set(repo "trunkszi/clang-cross")
    set(prefix "x86_64-unknown-linux-gnu")
    set(compiler "bin/clang++")
  elseif(name STREQUAL "clang-musl")
    set(repo "trunkszi/clang-cross")
    set(prefix "x86_64-unknown-linux-musl")
    set(compiler "bin/x86_64-unknown-linux-musl-clang++")
  elseif(name STREQUAL "gcc-glibc")
    set(repo "trunkszi/gcc-cross")
    set(prefix "x86_64-unknown-linux-gnu")
    set(compiler "bin/x86_64-unknown-linux-gnu-g++")
  elseif(name STREQUAL "gcc-musl")
    set(repo "trunkszi/gcc-cross")
    set(prefix "x86_64-unknown-linux-musl")
    set(compiler "bin/x86_64-unknown-linux-musl-g++")
  else()
    message(FATAL_ERROR "Unknown ZEROLOG_TOOLCHAIN_NAME '${name}'")
  endif()
  set(${out_repo} "${repo}" PARENT_SCOPE)
  set(${out_prefix} "${prefix}" PARENT_SCOPE)
  set(${out_compiler} "${compiler}" PARENT_SCOPE)
endfunction()

function(_zerolog_infer_toolchain_name out_var)
  if(NOT ZEROLOG_TOOLCHAIN_NAME STREQUAL "")
    set(${out_var} "${ZEROLOG_TOOLCHAIN_NAME}" PARENT_SCOPE)
    return()
  endif()
  set(inferred "")
  if(CMAKE_CXX_COMPILER)
    foreach(candidate IN ITEMS clang-glibc clang-musl gcc-glibc gcc-musl)
      string(FIND "${CMAKE_CXX_COMPILER}" "${ZEROLOG_TOOLCHAIN_ROOT}/${candidate}/" position)
      if(position EQUAL 0)
        set(inferred "${candidate}")
        break()
      endif()
    endforeach()
  endif()
  set(${out_var} "${inferred}" PARENT_SCOPE)
endfunction()

function(_zerolog_make_writable dir_path)
  if(EXISTS "${dir_path}")
    execute_process(COMMAND chmod -R u+w "${dir_path}" RESULT_VARIABLE chmod_status)
    if(NOT chmod_status EQUAL 0)
      message(FATAL_ERROR "Failed to restore write permissions on ${dir_path}")
    endif()
  endif()
endfunction()

function(_zerolog_ensure_clang_glibc_cfg sdk_dir)
  # The v0.0.1 clang-cross archive has no cfg, so a fresh clang++ cannot find libc++ or the sysroot.
  if(NOT EXISTS "${sdk_dir}/bin/clang++.cfg" OR NOT EXISTS "${sdk_dir}/bin/clang.cfg")
    _zerolog_make_writable("${sdk_dir}/bin")
  endif()
  if(NOT EXISTS "${sdk_dir}/bin/clang++.cfg")
    file(WRITE "${sdk_dir}/bin/clang++.cfg"
"--sysroot=<CFGDIR>/../x86_64-unknown-linux-gnu/sysroot
--gcc-toolchain=<CFGDIR>/..
-stdlib=libc++
-Wl,-rpath,<CFGDIR>/../x86_64-unknown-linux-gnu/sysroot/usr/lib
-Wl,-rpath,<CFGDIR>/../lib/x86_64-unknown-linux-gnu
")
  endif()
  if(NOT EXISTS "${sdk_dir}/bin/clang.cfg")
    file(WRITE "${sdk_dir}/bin/clang.cfg"
"--sysroot=<CFGDIR>/../x86_64-unknown-linux-gnu/sysroot
--gcc-toolchain=<CFGDIR>/..
")
  endif()
  if(NOT EXISTS "${sdk_dir}/bin/clang++.cfg" OR NOT EXISTS "${sdk_dir}/bin/clang.cfg")
    message(FATAL_ERROR "Failed to write clang cfg files in ${sdk_dir}/bin")
  endif()
endfunction()

function(_zerolog_provision_sdk sdk_name distro)
  _zerolog_toolchain_spec("${sdk_name}" repo prefix rel_compiler)
  set(install_dir "${ZEROLOG_TOOLCHAIN_ROOT}/${sdk_name}")
  set(compiler_path "${install_dir}/${rel_compiler}")
  if(EXISTS "${compiler_path}")
    if(sdk_name STREQUAL "clang-glibc")
      _zerolog_ensure_clang_glibc_cfg("${install_dir}")
    endif()
    return()
  endif()
  if(NOT ZEROLOG_AUTO_DOWNLOAD_TOOLCHAIN)
    message(FATAL_ERROR
      "Toolchain compiler is missing: ${compiler_path}. Install it or enable ZEROLOG_AUTO_DOWNLOAD_TOOLCHAIN.")
  endif()
  # clang-glibc and gcc-glibc publish the same archive basename from different repositories.
  # All three repositories share SDK trees; acquire their locks in one order.
  file(MAKE_DIRECTORY "${ZEROLOG_TOOLCHAIN_ROOT}")
  file(LOCK "${ZEROLOG_TOOLCHAIN_ROOT}/.uarch-${sdk_name}.lock" GUARD FUNCTION TIMEOUT 600)
  file(LOCK "${ZEROLOG_TOOLCHAIN_ROOT}/.uring-${sdk_name}.lock" GUARD FUNCTION TIMEOUT 600)
  file(LOCK "${ZEROLOG_TOOLCHAIN_ROOT}/.zerolog-${sdk_name}.lock" GUARD FUNCTION TIMEOUT 600)
  if(EXISTS "${compiler_path}")
    if(sdk_name STREQUAL "clang-glibc")
      _zerolog_ensure_clang_glibc_cfg("${install_dir}")
    endif()
    return()
  endif()
  string(RANDOM LENGTH 8 _stage_id)
  set(archive_name "${prefix}-${distro}.tar.xz")
  set(url "https://github.com/${repo}/releases/download/${ZEROLOG_TOOLCHAIN_RELEASE}/${archive_name}")
  set(download_dir "${ZEROLOG_TOOLCHAIN_ROOT}/downloads")
  file(MAKE_DIRECTORY "${download_dir}")
  set(archive_path "${download_dir}/${sdk_name}-${archive_name}")
  set(archive_part "${archive_path}.${_stage_id}.part")
  set(digest_path "${archive_path}.sha256")
  set(digest_part "${digest_path}.${_stage_id}.part")
  message(STATUS "Downloading toolchain ${url}")
  file(DOWNLOAD "${url}" "${archive_part}" STATUS archive_status TLS_VERIFY ON TIMEOUT 600)
  list(GET archive_status 0 archive_code)
  if(NOT archive_code EQUAL 0)
    list(GET archive_status 1 archive_message)
    file(REMOVE "${archive_part}")
    message(FATAL_ERROR "Toolchain download failed: ${url} (${archive_message})")
  endif()
  file(DOWNLOAD "${url}.sha256" "${digest_part}" STATUS digest_status TLS_VERIFY ON TIMEOUT 120)
  list(GET digest_status 0 digest_code)
  if(NOT digest_code EQUAL 0)
    list(GET digest_status 1 digest_message)
    file(REMOVE "${archive_part}" "${digest_part}")
    message(FATAL_ERROR "Toolchain checksum download failed: ${url}.sha256 (${digest_message})")
  endif()
  file(READ "${digest_part}" digest_text)
  string(REGEX MATCH "[A-Fa-f0-9]+" expected_digest "${digest_text}")
  string(LENGTH "${expected_digest}" digest_length)
  if(NOT digest_length EQUAL 64)
    file(REMOVE "${archive_part}" "${digest_part}")
    message(FATAL_ERROR "Toolchain checksum file has no SHA256 digest: ${digest_part}")
  endif()
  string(TOLOWER "${expected_digest}" expected_digest)
  file(SHA256 "${archive_part}" actual_digest)
  string(TOLOWER "${actual_digest}" actual_digest)
  if(NOT actual_digest STREQUAL expected_digest)
    file(REMOVE "${archive_part}" "${digest_part}")
    message(FATAL_ERROR "Toolchain SHA256 mismatch for ${archive_name}")
  endif()
  # Publish the archive only after the digest matches, so a concurrent configure
  # never extracts a partial download.
  file(RENAME "${archive_part}" "${archive_path}")
  file(RENAME "${digest_part}" "${digest_path}")
  # A private staging directory keeps a killed configure from deleting the other process's extract.
  set(staging_dir "${ZEROLOG_TOOLCHAIN_ROOT}/.staging-${sdk_name}-${_stage_id}")
  _zerolog_make_writable("${staging_dir}")
  file(REMOVE_RECURSE "${staging_dir}")
  file(MAKE_DIRECTORY "${staging_dir}")
  execute_process(COMMAND tar -xJf "${archive_path}" -C "${staging_dir}" --strip-components=1
    RESULT_VARIABLE tar_status)
  if(NOT tar_status EQUAL 0)
    _zerolog_make_writable("${staging_dir}")
    file(REMOVE_RECURSE "${staging_dir}")
    message(FATAL_ERROR "Failed to extract ${archive_path}")
  endif()
  # Release archives preserve read-only directory modes even for their owner.
  _zerolog_make_writable("${staging_dir}")
  if(NOT EXISTS "${staging_dir}/${rel_compiler}")
    _zerolog_make_writable("${staging_dir}")
    file(REMOVE_RECURSE "${staging_dir}")
    message(FATAL_ERROR "Toolchain archive did not contain ${rel_compiler}")
  endif()
  if(sdk_name STREQUAL "clang-glibc")
    _zerolog_ensure_clang_glibc_cfg("${staging_dir}")
  endif()
  if(EXISTS "${install_dir}")
    _zerolog_make_writable("${install_dir}")
    file(REMOVE_RECURSE "${install_dir}")
  endif()
  file(RENAME "${staging_dir}" "${install_dir}")
endfunction()

function(zerolog_ensure_toolchain)
  # add_subdirectory() inherits the parent's PROJECT_IS_TOP_LEVEL=TRUE before this
  # file reaches its own project(). Compare source directories first.
  if(NOT CMAKE_SOURCE_DIR STREQUAL CMAKE_CURRENT_SOURCE_DIR)
    return()
  endif()
  if(NOT ZEROLOG_AUTO_DOWNLOAD_TOOLCHAIN)
    return()
  endif()
  _zerolog_infer_toolchain_name(toolchain_name)
  if(toolchain_name STREQUAL "")
    return()
  endif()
  _zerolog_toolchain_spec("${toolchain_name}" repo prefix rel_compiler)
  set(install_dir "${ZEROLOG_TOOLCHAIN_ROOT}/${toolchain_name}")
  set(compiler_path "${install_dir}/${rel_compiler}")
  set(uses_sdk FALSE)
  if(NOT CMAKE_CXX_COMPILER OR CMAKE_CXX_COMPILER STREQUAL "${compiler_path}")
    set(uses_sdk TRUE)
  endif()
  string(FIND "${CMAKE_CXX_COMPILER}" "${install_dir}/" sdk_prefix)
  if(sdk_prefix EQUAL 0)
    set(uses_sdk TRUE)
  endif()
  if(uses_sdk)
    _zerolog_provision_sdk("${toolchain_name}" "${ZEROLOG_TOOLCHAIN_DISTRO}")
  endif()
  if(EXISTS "${compiler_path}" AND NOT CMAKE_CXX_COMPILER)
    set(CMAKE_CXX_COMPILER "${compiler_path}" CACHE FILEPATH "C++ compiler" FORCE)
  endif()
  if(uses_sdk AND NOT EXISTS "${compiler_path}")
    message(FATAL_ERROR "Toolchain archive did not contain ${rel_compiler}")
  endif()
  # option() has not run yet. -D defines these; otherwise llvm tools and the foreign compiler
  # are required whenever tests or tools will be built.
  if(((NOT DEFINED BUILD_TESTING OR BUILD_TESTING) AND (NOT DEFINED ZEROLOG_BUILD_TESTS OR ZEROLOG_BUILD_TESTS)) OR ZEROLOG_BUILD_TOOLS)
    _zerolog_provision_sdk("clang-glibc" "${ZEROLOG_TOOLCHAIN_DISTRO}")
    if(toolchain_name STREQUAL "gcc-musl")
      _zerolog_provision_sdk("clang-musl" "${ZEROLOG_TOOLCHAIN_DISTRO}")
    endif()
  endif()
endfunction()
