include_guard(GLOBAL)

function(zerolog_create_libraries)
  find_package(uarch CONFIG REQUIRED)
  find_package(uring CONFIG REQUIRED)
  foreach(layer IN ITEMS error abi sys core encode format sink)
    add_library(zerolog_${layer} INTERFACE)
    add_library(zerolog::${layer} ALIAS zerolog_${layer})
    set_target_properties(zerolog_${layer} PROPERTIES EXPORT_NAME ${layer})
    target_compile_features(zerolog_${layer} INTERFACE cxx_std_26)
    target_compile_options(zerolog_${layer} INTERFACE ${ZEROLOG_REFLECTION_OPTIONS})
    target_link_options(zerolog_${layer} INTERFACE ${ZEROLOG_REFLECTION_OPTIONS})
    target_include_directories(zerolog_${layer} INTERFACE
      "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/include>"
      "$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>")
    target_link_libraries(zerolog_${layer} INTERFACE uarch::uarch)
  endforeach()
  target_link_libraries(zerolog_error INTERFACE uring::error)
  target_link_libraries(zerolog_abi INTERFACE zerolog::error uring::futex2)
  target_link_libraries(zerolog_sys INTERFACE zerolog::abi uring::sys uarch::detect)
  target_link_libraries(zerolog_encode INTERFACE zerolog::abi)
  target_link_libraries(zerolog_format INTERFACE zerolog::encode zerolog::sys)
  # producer.hpp and consumer_core.hpp include encode and format headers.
  # format closes over encode and sys and does not pull sink or uring::uring.
  target_link_libraries(zerolog_core INTERFACE zerolog::sys zerolog::format)
  target_link_libraries(zerolog_sink INTERFACE zerolog::core zerolog::format uring::uring)
  add_library(zerolog INTERFACE)
  add_library(zerolog::zerolog ALIAS zerolog)
  set_target_properties(zerolog PROPERTIES EXPORT_NAME zerolog)
  target_link_libraries(zerolog INTERFACE zerolog::sink)
endfunction()

function(zerolog_configure_internal target)
  cmake_parse_arguments(PARSE_ARGV 1 ARG "NO_SANITIZERS" "LAYER" "")
  if(ARG_LAYER)
    target_link_libraries(${target} PRIVATE zerolog::${ARG_LAYER})
  else()
    target_link_libraries(${target} PRIVATE zerolog::zerolog)
  endif()
  set_target_properties(${target} PROPERTIES CXX_EXTENSIONS OFF)
  if(NOT COMMAND uarch_configure_runtime)
    message(FATAL_ERROR "uarch_configure_runtime is required")
  endif()
  uarch_configure_runtime(${target})
  zerolog_enable_warnings(${target})
  if(NOT ARG_NO_SANITIZERS)
    zerolog_enable_sanitizers(${target})
  endif()
endfunction()

function(zerolog_add_test target)
  cmake_parse_arguments(PARSE_ARGV 1 ARG "" "LAYER" "")
  add_executable(${target} ${ARG_UNPARSED_ARGUMENTS})
  if(ARG_LAYER)
    zerolog_configure_internal(${target} LAYER ${ARG_LAYER})
  else()
    zerolog_configure_internal(${target})
  endif()
  target_include_directories(${target} PRIVATE "${ZEROLOG_TESTS_ROOT_DIR}")
  target_link_libraries(${target} PRIVATE Threads::Threads)
  add_test(NAME ${target} COMMAND ${target})
endfunction()

